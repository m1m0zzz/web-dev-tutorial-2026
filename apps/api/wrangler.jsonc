{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "memo-app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "vars": {
    "CORS_ORIGIN": "http://localhost:5173",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memo-app-db",
      "database_id": "0347d737-6ea6-4617-9c23-88d0e0b34f77",
      "migrations_dir": "drizzle",
    },
  ],
  // 本番だけ値を変えたいものは、環境として分ける。
  // vars と d1_databases は環境に継承されないため、ここに書き直す
  "env": {
    "production": {
      // 書かないと Worker 名が memo-app-api-production になり、URL が変わる
      "name": "memo-app-api",
      "vars": {
        "CORS_ORIGIN": "https://memo-app-web.<サブドメイン>.workers.dev",
        "BETTER_AUTH_URL": "https://memo-app-api.<サブドメイン>.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "memo-app-db",
          "database_id": "local",
          "migrations_dir": "drizzle",
        },
      ],
    },
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
